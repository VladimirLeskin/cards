{
  "name": "deckforge",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "test": "node --test scripts/publish-pages.test.mjs && npm test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "demo": "npm run demo --workspace @deckforge/hogwarts && npm run demo --workspace @deckforge/anatomy-park",
    "dev:hogwarts": "npm run dev --workspace @deckforge/hogwarts",
    "dev:anatomy-park": "npm run dev --workspace @deckforge/anatomy-park",
    "build:pages": "node scripts/build-pages.mjs"
  },
  "license": "MIT"
}
